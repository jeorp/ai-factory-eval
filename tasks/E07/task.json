{
  "id": "E07",
  "version": 2,
  "purpose": "同一台帳への並行送金で重複IDを一度だけ適用し、残高を保護する。",
  "requests": [
    "Ledger.Transferを修正してください。同じLedgerへの並行呼び出しに対応し、同じIDは高々1回だけ成功させ、残高不足・不正な送金は状態を変えずにエラーにしてください。失敗時はnilと空mapの区別や元のエントリも保持し、そのIDを消費しないでください。成功した送金は原子的に反映し、BalancesとSeenの既存エントリを保持してください。IDの重複排除はLedgerごとに独立し、過去のすべての成功IDを対象にしてください。BalancesとSeenは呼び出し中に外部から直接変更・参照されないものとし、既存の公開フィールドとTransferの署名を維持してください。"
  ],
  "allowed_paths": [
    "*.go"
  ],
  "forbidden_paths": [
    ".git/*",
    ".github/*",
    "*_test.go",
    "go.mod",
    "go.sum",
    "README.md",
    "grading/*"
  ],
  "max_files": 4,
  "max_bytes": 20000,
  "requirements": [
    {
      "id": "E07-R01",
      "description": "同一IDの同時リクエストを高々1回だけ反映し既存エントリも保持する",
      "tests": [
        "TestConcurrentReplay"
      ],
      "job": "requirements"
    },
    {
      "id": "E07-R02",
      "description": "並行送金の成功件数・残高・成功IDと失敗IDをすべて照合する",
      "tests": [
        "TestConcurrentBalance"
      ],
      "job": "requirements"
    },
    {
      "id": "E07-R03",
      "description": "不正・残高不足で全状態を保持する（nil/空mapと既存エントリを含む）",
      "tests": [
        "TestInvalidPreservesState"
      ],
      "job": "requirements"
    },
    {
      "id": "E07-R04",
      "description": "失敗したIDを消費せず、入金後は同じIDで再試行できる",
      "tests": [
        "TestFailedIDCanRetry"
      ],
      "job": "requirements"
    },
    {
      "id": "E07-R05",
      "description": "処理済みIDの再利用を異なる送金内容でも拒否し全状態を保持する",
      "tests": [
        "TestDuplicatePreservesState"
      ],
      "job": "requirements"
    },
    {
      "id": "E07-R06",
      "description": "過去の全IDを保持し、IDの重複排除は台帳ごとに独立する",
      "tests": [
        "TestIndependentLedgersAndIDs"
      ],
      "job": "requirements"
    },
    {
      "id": "E07-R07",
      "description": "160操作を独立した逐次モデルと毎回照合する",
      "tests": [
        "TestTransferSequence"
      ],
      "job": "requirements"
    },
    {
      "id": "E07-R08",
      "description": "go test -raceで共有状態へのデータ競合を検出する",
      "tests": [
        "TestRace"
      ],
      "job": "requirements"
    }
  ],
  "required_jobs": [
    "build",
